# CopilotKit + Claude Agent SDK (Python) test suite — environment
#
# There are TWO processes here, so there are two places these go:
#
#   backend/.env         read by the Python agent server (load_dotenv reads it)
#   frontend/.env.local  read by Next.js at startup
#
# Copy the relevant block into each. Never commit the filled-in files.


# ── backend/.env — required ──────────────────────────────────────────────────

# Anthropic API key. Every agent runs through ClaudeAgentAdapter, which reads
# this from the environment. Get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=your_anthropic_api_key


# ── backend/.env — optional ──────────────────────────────────────────────────

# The model every agent runs on. This is the Quickstart's value and its
# default; override it to try another Claude model across the whole harness.
# ANTHROPIC_MODEL=claude-sonnet-4-6

# Where the agent server listens. The frontend's default AGENT_URL assumes
# both of these, so change them together or not at all.
# AGENT_HOST=localhost
# AGENT_PORT=8000

# Uvicorn / adapter log level. Set to DEBUG to watch ClaudeAgentAdapter build
# its options — including the MCP server it assembles from frontend tools,
# which is the mechanism behind /frontend-tools, /generative-ui/tool-based and
# /human-in-the-loop.
# LOG_LEVEL=INFO


# ── frontend/.env.local — optional ───────────────────────────────────────────

# Where the Next runtime forwards agent runs. Defaults to http://localhost:8000.
# Set it if the agent server is on another host, port, or container.
# AGENT_URL=http://localhost:8000

# Kill switch for the CopilotKit Inspector. Set to `off` and restart to disable
# it app-wide without editing code. It is otherwise on for localhost only.
# NEXT_PUBLIC_COPILOTKIT_INSPECTOR=off

# OpenAI key, used for exactly one thing: Whisper transcription on the /voice
# route. Claude answers the chat; the mic does not. Without this key every
# other route works normally, /voice still runs via its sample-audio button,
# and clicking the mic returns a clear error instead of a 500.
# OPENAI_API_KEY=sk-...
